rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public-readable FAQs. Click counter is bumped through a server endpoint
    // that uses the Admin SDK, so no client write is allowed here.
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Knowledge base entries — only admins can manage; chat endpoint reads
    // them server-side with Admin SDK so client read is restricted to admins.
    match /knowledge/{docId} {
      allow read, write: if isAdmin();
    }

    // Chat conversations: only admin dashboard can read; the chat API writes
    // them server-side via Admin SDK.
    match /conversations/{convId} {
      allow read: if isAdmin();
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Admins collection — read by users to check their own role; only existing
    // admins (or server) can mutate.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Aggregated analytics (counters, daily stats…) — admin-only.
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
