# ============================================================
# Firebase Web Client Config (project: cbts-e6b0e)
# Lấy từ Firebase Console -> Project Settings -> Your apps
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cbts-e6b0e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cbts-e6b0e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cbts-e6b0e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ============================================================
# Firebase Admin (server-side) - Service Account credentials
# Khi deploy lên Google Cloud / Firebase App Hosting trong cùng
# project, có thể bỏ trống và dùng Application Default Credentials.
# ============================================================
FIREBASE_PROJECT_ID=cbts-e6b0e
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ============================================================
# Anthropic Claude API
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# Admin allowlist (email Google account quản trị, phân cách bằng dấu phẩy)
# Có thể để trống và set role qua Firestore (collection `admins/{uid}`)
# ============================================================
ADMIN_EMAILS=admin@yourdomain.edu.vn

# ============================================================
# University branding
# ============================================================
NEXT_PUBLIC_UNIVERSITY_NAME=Trường Đại học CBTS
NEXT_PUBLIC_UNIVERSITY_SHORT=CBTS
NEXT_PUBLIC_UNIVERSITY_TAGLINE=Tư vấn tuyển sinh 24/7
